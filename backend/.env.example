# Copia este archivo como .env y ajusta los valores si hace falta:
#   cp .env.example .env
# Con Docker no necesitas cambiar nada: docker-compose.yml define estas variables por ti.

# Puerto donde escucha el servidor Express
PORT=4000

# Conexión a MongoDB corriendo en tu computador (sin Docker)
MONGO_URI=mongodb://localhost:27017/real_estate

# Clave para firmar los tokens JWT. Esta es SOLO PARA DESARROLLO LOCAL
# (la misma de docker-compose.yml). Nunca uses esta clave en producción.
JWT_SECRET=e0e00448af4e2f0e4acb4f68f5c7b8c48a43ce10dd9bd54d789f5979591ddd7e

# Cuánto dura un token antes de expirar (formato: 15m, 1h, 1d...)
JWT_EXPIRES_IN=1d
