# Copia este archivo como .env y ajusta los valores si hace falta:
#   cp .env.example .env
# Con Docker no necesitas cambiar nada: docker-compose.yml define estas variables por ti.

# Puerto donde escucha el servidor Express
PORT=4000

# Conexión a MongoDB corriendo en tu computador (sin Docker)
MONGO_URI=mongodb://localhost:27017/real_estate
