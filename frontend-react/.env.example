# Copia este archivo como .env si corres el frontend sin Docker:
#   cp .env.example .env
# Con Docker no necesitas cambiar nada: docker-compose.yml define estas variables.
#
# Solo las variables que empiezan con VITE_ llegan al código del navegador.
# Nunca pongas aquí claves ni contraseñas: cualquiera puede leerlas en el JavaScript.

# URL base de la API (el backend con CORS habilitado para este origen)
VITE_API_URL=http://localhost:4000/api
